{
  "name": "luc-ui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-guard.mjs --check && pnpm --filter @luc/showcase dev",
  "dev:a": "node scripts/dev-guard.mjs --check && pnpm --filter @luc/showcase dev:a",
  "dev:b": "node scripts/dev-guard.mjs --check && pnpm --filter @luc/showcase dev:b",
    "dev:guard": "node scripts/dev-guard.mjs",
    "build": "pnpm --filter @luc/ui build:package",
    "build:package": "pnpm --filter @luc/ui build:package",
    "build:showcase": "node scripts/dev-guard.mjs --require-free-gb=10 && node scripts/qa-server.mjs --ensure-only",
    "verify:package": "pnpm --filter @luc/ui catalog:check && pnpm --filter @luc/ui build:package && pnpm --filter @luc/ui verify:package && pnpm --filter @luc/ui test:consumer && pnpm --filter @luc/ui verify:types",
    "typecheck": "pnpm -r --no-bail --filter='!luc-ui-workspace' typecheck",
    "lint": "pnpm -r --no-bail --filter='!luc-ui-workspace' lint",
    "test": "pnpm --filter @luc/ui test && pnpm --filter @luc/ui test:showcase && pnpm qa:tooling:test",
    "test:watch": "pnpm --filter @luc/ui test:watch",
    "qa:serve": "node scripts/qa-server.mjs --ensure-only",
    "qa:rebuild": "node scripts/dev-guard.mjs --require-free-gb=10 && node scripts/qa-server.mjs --rebuild --ensure-only",
    "qa:quick": "node scripts/qa-server.mjs --mode=changed",
    "qa:charts": "node scripts/qa-server.mjs --mode=changed --route-groups=charts",
    "qa:changed": "node scripts/qa-server.mjs --mode=changed",
    "qa:behaviour": "node scripts/qa-server.mjs --mode=behaviour",
    "qa:live": "node scripts/qa-server.mjs --mode=behaviour",
    "qa:full": "node scripts/qa-server.mjs --mode=full",
    "qa:consumer-capture": "pnpm --filter @luc/showcase qa:consumer-capture",
    "qa:mobile-a11y": "pnpm --filter @luc/showcase qa:mobile-a11y",
    "qa:visual": "node scripts/qa-server.mjs --mode=full",
    "qa:browser": "node scripts/qa-server.mjs --mode=behaviour",
    "qa:providers": "node scripts/qa-server.mjs --mode=providers --provider-mode=live",
    "qa:baseline": "pnpm --filter @luc/showcase qa:baseline",
    "qa:baseline:update": "pnpm --filter @luc/showcase qa:baseline:update",
    "qa:clean": "node scripts/qa-clean.mjs",
    "qa:product": "pnpm --filter @luc/showcase qa:product",
    "cache:prune": "node scripts/cache-prune.mjs",
    "cache:prune:safe": "node scripts/dev-guard.mjs --prune",
    "qa:clean:test": "node --test scripts/qa-clean.test.mjs scripts/cache-prune.test.mjs scripts/dev-guard.test.mjs",
    "qa:tooling:test": "node --test scripts/qa-clean.test.mjs scripts/cache-prune.test.mjs scripts/dev-guard.test.mjs scripts/preview-inputs.test.mjs scripts/release-artifact.test.mjs scripts/release-ci.test.mjs",
    "test:consumers": "node tests/consumers/run.mjs",
    "qa:dev-isolation": "pnpm --filter @luc/showcase qa:dev-isolation",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:i18n && pnpm verify:charts && pnpm verify:docs && pnpm verify:registry && pnpm verify:package && pnpm verify:release-artifact",
    "verify:release-artifact": "pnpm --filter @luc/ui release:check",
    "verify:i18n": "pnpm --filter @luc/showcase i18n:check",
    "verify:charts": "pnpm --filter @luc/showcase catalog:charts && pnpm --filter @luc/showcase catalog:units",
    "verify:v1": "pnpm verify",
    "qa:release": "pnpm verify && pnpm qa:preview-inputs && pnpm qa:full && pnpm qa:product && pnpm qa:providers && pnpm qa:baseline",
    "verify:release": "pnpm qa:release",
    "verify:docs": "pnpm --filter @luc/showcase docs:registry:check",
    "qa:preview-inputs": "node --test scripts/preview-inputs.test.mjs",
    "verify:registry": "pnpm --filter @luc/ui registry:check && pnpm --filter @luc/ui registry:verify"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "typescript-eslint": "8.70.1"
  }
}
