  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && pnpm run build:package",
    "build:package": "tsdown && node scripts/postbuild.mjs",
    "release:build": "pnpm run build:package && node scripts/release-artifact.mjs",
    "release:check": "pnpm run build:package && node scripts/release-artifact.mjs --check",
    "test:git-consumer": "node scripts/git-consumer.mjs",
    "test:git-consumer:remote": "node scripts/git-consumer.mjs --remote",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:types": "node scripts/verify-types.mjs",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "catalog:self-test": "node scripts/generate-catalog.mjs --self-test",
    "test:independent-consumer": "node scripts/independent-consumer.mjs",
    "test:consumer": "node scripts/consumer-test.mjs",
    "pack:local": "pnpm pack --pack-destination ../../artifacts/pack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:showcase": "vitest run -c vitest.showcase.config.ts",
    "registry:generate": "node scripts/registry-generate.mjs",
    "registry:check": "node scripts/registry-generate.mjs --check",
    "registry:verify": "node scripts/registry-verify.mjs"
  },
