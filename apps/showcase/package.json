{
  "name": "@luc/showcase",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:a": "LUC_NEXT_DIST_DIR=.next-a next dev --port 3300",
    "dev:b": "LUC_NEXT_DIST_DIR=.next-b next dev --port 3301",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:check": "wrangler deploy --dry-run --outdir .open-next/dry-run",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:upload": "opennextjs-cloudflare upload",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "qa:visual": "node scripts/visual-qa.mjs",
    "i18n:check": "node scripts/i18n-coverage.mjs",
    "i18n:pending": "node scripts/i18n-pending.mjs",
    "catalog:charts": "node scripts/chart-catalog.mjs",
    "catalog:units": "node qa/chart-units.mjs",
    "qa:inspect": "node qa/inspect.mjs",
    "qa:health": "node qa/route-health.mjs",
    "qa:preview": "node qa/preview-check.mjs",
    "qa:dev": "node qa/dev-hmr.mjs",
    "qa:dev-isolation": "node qa/dev-isolation.mjs",
    "qa:standalone": "node qa/standalone.mjs",
    "qa:nav": "node qa/navigation.mjs",
    "qa:sidebar": "node qa/sidebar-continuity.mjs",
    "qa:journey": "node qa/journey.mjs",
    "qa:locale": "node qa/locale.mjs",
    "qa:motion": "node qa/motion.mjs",
    "qa:outline": "node qa/outline.mjs",
    "qa:playground": "node qa/playground.mjs",
    "qa:card-stack": "node qa/card-stack.mjs",
    "qa:charts:geometry": "node qa/chart-geometry.mjs",
    "qa:charts:assert": "node qa/chart-assertions.mjs",
    "qa:charts:thumbnails": "node qa/chart-thumbnails.mjs",
    "qa:baseline": "playwright test -c playwright.config.mjs",
    "qa:baseline:update": "playwright test -c playwright.config.mjs --update-snapshots",
    "qa:consumer-capture": "node scripts/consumer-capture.mjs",
    "qa:mobile-a11y": "node qa/mobile-a11y.mjs",
    "qa:overflow": "node qa/mobile-overflow.mjs",
    "qa:dead-controls": "node qa/dead-controls.mjs",
    "qa:dead-controls:claims": "node qa/dead-controls.mjs --claims --max-clicks=14",
    "qa:reduced-motion": "node qa/reduced-motion.mjs",
    "qa:brand": "node qa/brand-assets.mjs",
    "qa:product": "pnpm qa:contracts && node qa/content-contract.mjs && node qa/mobile-overflow.mjs && node qa/dead-controls.mjs && node qa/dead-controls.mjs --claims --negative-test --routes=components-toggle && node qa/dead-controls.mjs --claims --max-clicks=14 && node qa/reduced-motion.mjs --negative-test --routes=motion-kinetic && node qa/reduced-motion.mjs && node qa/reduced-motion.mjs --open-overlay --negative-test --routes=dialog && node qa/reduced-motion.mjs --open-overlay && node qa/target-size.mjs && node qa/brand-assets.mjs && node qa/i18n-live.mjs",
    "docs:registry": "node scripts/docs-registry.mjs",
    "content:acceptance": "node scripts/content-acceptance.mjs",
    "docs:registry:check": "node scripts/docs-registry.mjs --check",
    "visuals:geometry": "node scripts/visuals-element-geometry.mjs",
    "visuals:geometry:check": "node scripts/visuals-element-geometry.mjs --check",
    "qa:nav:contract": "node --test qa/page-kind.test.mjs qa/route-coverage.test.mjs",
    "qa:api": "node qa/api-delivery.mjs",
    "qa:api:contract": "node --test qa/api-delivery.test.mjs",
    "qa:i18n:contract": "node --test qa/i18n-chrome.test.mjs qa/id-lists.test.mjs",
    "qa:contracts": "pnpm qa:nav:contract && pnpm qa:i18n:contract && pnpm qa:api:contract",
    "qa:target-size": "node qa/target-size.mjs",
    "qa:content-contract": "node qa/content-contract.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@luc/ui": "workspace:*",
    "@remixicon/react": "4.9.0",
    "next": "16.3.6",
    "nuqs": "2.10.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@opennextjs/cloudflare": "1.20.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.151.1"
  }
}
