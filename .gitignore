# Build output
node_modules/
.next/
# Per-session Next output directories (CONCURRENCY-001).
#
# `pnpm dev:a` / `pnpm dev:b` give each development session its own `distDir`
# so two agents cannot write one Turbopack cache and one set of manifests. Those
# directories are build output exactly like `.next`, and `.next-qa-*` is what
# the isolation probe uses. Without this line they show up as untracked source.
.next-*/
# Cloudflare Workers build output and local Wrangler state
.open-next/
.wrangler/
*.cpuprofile
# Generated by `next dev` / `next build`, and rewritten on every start with the
# import path of whichever output directory ran last — `.next/dev/types/…`, or
# `.next-a/dev/types/…` for an isolated session. Two sessions would therefore
# rewrite a tracked file in turn, so this one is not tracked (which is also what
# Next's own create-next-app template does). `pnpm typecheck` passes without it:
# measured with `tsc --noEmit --incremental false` on 2026-10-13.
apps/showcase/next-env.d.ts
out/
dist/
*.tsbuildinfo
**/*.tsbuildinfo

# The git-installable release artifact (CONSUMERS.md §"Install from git").
#
# `pnpm --filter @luc/ui release:build` unpacks the packed `@luc/ui` into this
# directory so it can be committed on the `release` branch. It is a build
# output *here*: on `main` the source and `packages/ui/package.json` are the
# truth, and the tree a consumer installs is the tagged `release` commit.
release/

# Test / QA output
coverage/
test-results/
playwright-report/
.playwright/

# QA artifacts.
#
# Only `artifacts/baselines/` is committed: it is the small, deliberate set of
# pixel-diff baselines asserted by `pnpm qa:baseline`. Everything else under
# `artifacts/` is regenerated by a QA run, so keeping it in git produced a
# 236-file diff after every run and made real changes impossible to review.
# `pnpm qa:clean` removes exactly these paths.
artifacts/screenshots/
artifacts/chart-review/
artifacts/pack/
artifacts/qa/
artifacts/qa-report.json
artifacts/consumers/
# Independent acceptance evidence (Agent C) and its probe scripts. Regenerated on
# every audit run, so it belongs with the other QA output rather than in review
# diffs. The audit *reports* live in `docs/audits/.../qa-independent/` and are
# committed; only the screenshots/JSON here are ignored.
artifacts/qa-independent/
artifacts/reliability/

# Local env
.env
.env.local
.env.*.local

# Editor / OS
.DS_Store
*.log
